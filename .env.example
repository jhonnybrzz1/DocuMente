# OpenRouter API Key (Recomendado/Principal)
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI API Key (Fallback opcional se a OpenRouter não estiver configurada)
# Obtenha sua chave em: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Database (opcional - usa in-memory sqlite local por padrão)
DATABASE_URL=postgresql://usuario:senha@host/database

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente
NODE_ENV=development
